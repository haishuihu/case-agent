APP_NAME=Internal Test Case Assistant
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/testcase_assistant

DEFAULT_MODEL_KEY=minimax

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=128000
LLM_TIMEOUT_SECONDS=60
LLM_SUPPORTS_VISION=true

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_MAX_OUTPUT_TOKENS=64000
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_SUPPORTS_VISION=false
DEEPSEEK_SUPPORTS_STRUCTURED_OUTPUT=true

MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=MiniMax-M2.7-highspeed
MINIMAX_MAX_OUTPUT_TOKENS=131072
MINIMAX_TIMEOUT_SECONDS=300
MINIMAX_SUPPORTS_VISION=false
MINIMAX_SUPPORTS_STRUCTURED_OUTPUT=false

MAX_UPLOAD_SIZE_MB=10
MAX_DOCUMENT_CHARS_PER_FILE=8000
MAX_TOTAL_DOCUMENT_CHARS=20000
MAX_UPLOAD_FILES=6

# 异步生成任务的最大运行时长（分钟），超时后自动标记为 failed；默认值 45 分钟
# 注意：Phase2/Phase3-5 管道耗时差异大，若模型输出能力强可适度缩短，复杂需求可适度放宽
GENERATION_MAX_RUNTIME_MINUTES=45

# 可选：向量检索。不配 EMBEDDING_API_KEY 时知识库仅用标签/SQL 检索。
#
# 阿里云百炼 qwen3-vl-embedding（多模态向量，走原生接口，模型名含 vl-embedding 时自动选用）：
# EMBEDDING_API_KEY=your_dashscope_api_key
# EMBEDDING_MODEL=qwen3-vl-embedding
# EMBEDDING_DIMENSIONS=2560
# 如需新加坡等地域，设置 EMBEDDING_DASHSCOPE_MULTIMODAL_URL 为控制台文档中的多模态 embedding URL
#
# 阿里云百炼 text-embedding-v4 等（OpenAI 兼容 /v1/embeddings）：
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=your_dashscope_api_key
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
#
# OpenAI：可不设 BASE_URL；EMBEDDING_MODEL=text-embedding-3-small；EMBEDDING_DIMENSIONS=1536 或 0
